# 편집기 공통 설정 (Visual Studio, VS Code, CLion 이 자동으로 읽는다)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = space
indent_size = 4

# GLSL 셰이더. clang-format 은 GLSL 을 지원하지 않으므로 편집기 설정으로만 맞춘다.
[*.{vert,frag,geom,glsl}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
